<?xml version="1.0" encoding="utf-8"?>
<!-- A manually pinned country must not follow the user onto a new phone in a
     different country. Nothing here is worth restoring. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
